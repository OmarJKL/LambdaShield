# =========================================================
# Lambda Shield - plantilla de credenciales
# =========================================================
# Copia este archivo como .env y ajusta los valores:
#
#   copy .env.example .env
#
# El perfil dev permite HTTP y credenciales locales. En producción usa prod.
# =========================================================

SPRING_PROFILES_ACTIVE=dev
DB_USER=postgres
DB_PASSWORD=postgres

# Opcionales: si no se definen, apuntan a localhost:5432/lambda_shield
#DB_HOST=localhost
#DB_PORT=5432
#DB_NAME=lambda_shield

# Solo para desarrollo local: cambia a true para crear datos y usuarios de demostración.
DEMO_DATA_ENABLED=false
# Actívalo al servir la aplicación exclusivamente mediante HTTPS.
SESSION_COOKIE_SECURE=false
# Límites por minuto y por instancia
LOGIN_RATE_LIMIT=10
API_RATE_LIMIT=120
API_WRITE_RATE_LIMIT=40

# Carga ampliada de cuentas e historial. Usar solo en desarrollo; luego dejar false.
DEMO_DATASET_ENABLED=false

# OpenRouter: crea una clave API en https://openrouter.ai/settings/keys.
LLM_ENABLED=false
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-3.5-super-vl:free
LLM_TIMEOUT_SECONDS=25
LLM_DISABLE_THINKING=true
